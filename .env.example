# Copy to .env and fill in. Never commit the real .env file.
DOMAIN=shop.example.com
PUBLIC_URL=https://shop.example.com

# First admin account (used only the very first time the store starts)
ADMIN_PHONE=07500000000
ADMIN_PASSWORD=change-me-to-a-long-password

# Verification codes: console | whatsapp | twilio
SMS_PROVIDER=whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# New-order alerts on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
