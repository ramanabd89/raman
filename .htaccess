# RamanPhone — Apache / LiteSpeed (Hostinger). Works at the domain root or in a sub-folder.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Pass "Authorization: Bearer …" to PHP (API clients)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Private code and data are never served
  RewriteRule (^|/)(app|lang|database|storage|tests)(/|$) - [F,L]
  RewriteRule (^|/)(config\.php|config\.sample\.php|\.user\.ini|README\.md)$ - [F,L]
  RewriteRule (^|/)\.(?!well-known) - [F,L]

  # Real files (css, js, images, uploads, install.php) are served directly; everything else → index.php
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  <FilesMatch "\.(css|js|svg|png|jpe?g|webp|woff2?|json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

AddType application/manifest+json .webmanifest
